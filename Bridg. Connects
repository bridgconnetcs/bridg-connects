function setLang(l){
  document.body.classList.toggle('es',l==='es');
  document.querySelectorAll('.lang-btn').forEach(b=>b.classList.toggle('active',b.textContent.trim()===l.toUpperCase()));
}

function calcEst(){
  // Captura estricta de todos los campos obligatorios
  const name = document.getElementById('name').value.trim();
  const phone = document.getElementById('phone').value.trim();
  const pu = document.getElementById('pickup').value.trim();
  const dr = document.getElementById('dropoff').value.trim();
  
  const load = document.getElementById('loadType').value;
  const win = document.getElementById('window').value;
  const es = document.body.classList.contains('es');
  
  // BLOQUEO: Si falta CUALQUIER información de contacto u obra, no se genera el estimado
  if(!name || !phone || !pu || !dr){
    alert(es ? '❌ Por favor, completa tu Nombre, Teléfono, Recogida y Entrega antes de calcular tu tarifa.' : '❌ Please fill out your Name, Phone, Pickup, and Delivery location before calculating your rate.');
    return;
  }

  // --- LÓGICA DE ESTIMACIÓN REALISTA Y DINÁMICA ---
  const base = 35; 
  
  // Simulación inteligente de distancia en SoCal basada en texto
  let checkText = (pu + " " + dr).toLowerCase();
  let distEst = Math.floor(Math.random() * 12) + 8; // Rango local base (8-20 millas)
  if (checkText.includes('palmdale') || checkText.includes('lancaster')) {
    if (checkText.includes('los angeles') || checkText.includes('alhambra') || checkText.includes('long beach') || checkText.includes('pasadena')) {
      distEst = Math.floor(Math.random() * 15) + 55; // Distancia real cruzando hacia la cuenca de LA (55-70 mi)
    }
  }
  
  const costPerMile = 2.25; 
  const distCharge = Math.round(distEst * costPerMile);

  // Recargos por volumen de carga (Pick-up truck vs Carga Ligera)
  const lm = { light: 0, medium: 20, heavy: 45, xl: 85 };
  // Recargos por urgencia / demanda (ASAP vs Programado)
  const wm = { asap: 25, today: 0, scheduled: -5 };
  
  const lf = lm[load] !== undefined ? lm[load] : 0;
  const pf = wm[win] !== undefined ? wm[win] : 0;
  
  const tot = base + distCharge + lf + pf;
  
  // Desglose transparente en la UI
  document.getElementById('br').textContent = '$' + base;
  document.getElementById('dc').textContent = '$' + distCharge + ' (~' + distEst + ' mi)';
  document.getElementById('lc').textContent = '$' + lf;
  document.getElementById('pc').textContent = '$' + pf;
  document.getElementById('tot').textContent = 'EST. $' + tot;
  
  // Almacenar el total calculado para la orden final
  document.getElementById('tot').setAttribute('data-calculated-total', tot);
  
  // Mostrar la caja de resultados de forma elegante
  const ep = document.getElementById('ep');
  ep.classList.add('show');
  ep.scrollIntoView({behavior:'smooth',block:'nearest'});
}

